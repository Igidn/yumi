{
  "name": "yumi",
  "version": "0.1.0",
  "description": "A very cool ebook reader.",
  "author": "Igidn",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -n main,renderer -c blue,green \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && npm run rebuild && electron dist/main/index.js",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "package": "npm run build && electron-builder",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.main.json && electron dist/main/migrate.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@xmldom/xmldom": "^0.9.10",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "^0.38.0",
    "edge-tts-universal": "^1.4.0",
    "electron-store": "^10.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.0",
    "lucide-react": "^1.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/katex": "^0.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.28.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0"
  }
}
